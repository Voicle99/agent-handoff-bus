<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.agent-handoff-auto-reply</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>AGENT_HANDOFF_HOME=${HOME}/.agent-handoff-bus</string>
    <string>${PYTHON_BIN}</string>
    <string>-m</string>
    <string>agent_handoff_bus.auto_reply</string>
    <string>--sessions</string>
    <string>agent-b</string>
    <string>--fallback-source</string>
    <string>agent-a</string>
  </array>
  <key>StandardOutPath</key>
  <string>${HOME}/.agent-handoff-bus/log/auto_reply.out.log</string>
  <key>StandardErrorPath</key>
  <string>${HOME}/.agent-handoff-bus/log/auto_reply.err.log</string>
</dict>
</plist>
